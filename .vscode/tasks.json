{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build Video Encoder",
			"type": "shell",
			"command": "g++",
			"args": [
				"-std=c++17",
				"-O2",
				"-Wall",
				"-Wextra",
				"-I${workspaceFolder}\\Encoder\\include",
				"${workspaceFolder}\\Encoder\\src",
				"-lstdc++fs",
				"-o",
				"${workspaceFolder}\\output\\qr_video_encoder.exe"
			],
			"group": "build",
			"detail": "Build QR video encoder with g++."
		},
		{
			"label": "Build Video Decoder (OpenCV)",
			"type": "shell",
			"command": "cmd",
			"args": [
				"/d",
				"/s",
				"/c",
				"g++ -std=c++17 -O2 -Wall -Wextra -I\"${workspaceFolder}\\Decoder\\include\" -I\"%OPENCV_INCLUDE%\" \"${workspaceFolder}\\Decoder\\src\\main.cpp\" -L\"%OPENCV_LIB%\" %OPENCV_LIBS% -o \"${workspaceFolder}\\output\\qr_video_decoder.exe\""
			],
			"group": "build",
			"detail": "Build QR video decoder with OpenCV (requires OPENCV_INCLUDE, OPENCV_LIB, OPENCV_LIBS)."
		},
		{
			"label": "Run Encoder Demo",
			"type": "shell",
			"dependsOn": ["Build Video Encoder (g++)"],
			"dependsOrder": "sequence",
			"command": "${workspaceFolder}\\output\\qr_video_encoder.exe",
			"args": [
				"${workspaceFolder}\\output\\test.jpg",
				"${workspaceFolder}\\output\\qr_video.mp4",
				"1000",
			],
			"group": "test",
			"detail": "Build and run demo"
		}
	]
}
