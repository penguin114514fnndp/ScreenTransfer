{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build Video Encoder",
			"type": "shell",
			"command": "g++",
			"args": [
				"-std=c++17",
				"-O2",
				"-Wall",
				"-Wextra",
				"-I${workspaceFolder}\\Encoder\\include",
				"${workspaceFolder}\\Encoder\\src",
				"-lstdc++fs",
				"-o",
				"${workspaceFolder}\\output\\qr_video_encoder.exe"
			],
			"group": "build",
			"detail": "Build QR video encoder with g++."
		},
		{
			"label": "Run Encoder Demo",
			"type": "shell",
			"dependsOn": ["Build Video Encoder (g++)"],
			"dependsOrder": "sequence",
			"command": "${workspaceFolder}\\output\\qr_video_encoder.exe",
			"args": [
				"${workspaceFolder}\\output\\test.jpg",
				"${workspaceFolder}\\output\\qr_video.mp4",
				"1000",
			],
			"group": "test",
			"detail": "Build and run demo"
		}
	]
}